#!/bin/bash -e

ROOT=`dirname $0`

cd "$ROOT/.."

SKIP_TRANSLATIONS=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip-translations)
      SKIP_TRANSLATIONS=true
      shift
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

# Sela keeps its translations (he.json) in this repository and generates
# en.json from the source in the web build, so nothing is downloaded here.
# (Upstream cloned a translations repository into locale/ and ran
# "git checkout ." and "git pull" inside it; in Sela that folder belongs to
# this repository, so those commands would have discarded local changes.)
# --skip-translations is still accepted so existing calls keep working.
if [ "$SKIP_TRANSLATIONS" = false ]; then
  echo "Translations are part of the repository; nothing to download."
fi

lage build:browser --to=@actual-app/web
